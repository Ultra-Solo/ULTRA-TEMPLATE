{
  "$comment": "Every tool this repository runs at a version it pins by hand, because Dependabot cannot see it: one place for the version, the release it comes from and, for a downloaded binary, the SHA-256 taken from that release. scripts/tools.mjs installs, runs and bumps them from here, the workflows and the agent environment read them from here, and check-hygiene rule 16 fails on a pin written anywhere else. `for` says where a tool is needed: `chassis` everywhere, a toolchain name wherever a module of that toolchain is present, and `ci` only in CI. `check` is how scripts/verify.mjs runs a chassis tool when it is installed, `actions` lists the setup actions that would install a tool outside its pin, which check-hygiene rule 16 fails in a workflow, and `uses` lists the commands that check runs when they are on PATH and quietly goes without otherwise: verify reports each one missing as skipped by name and holds one pinned here to its pin, and installing the tool installs it. `devcontainer` names the Dev Container feature option that installs a tool, which check-hygiene rule 17 holds to the version here. docs/toolchain-updates.md says how to move one.",
  "tools": {
    "actionlint": {
      "version": "1.7.12",
      "for": "chassis",
      "releases": {
        "github": "rhysd/actionlint"
      },
      "platforms": {
        "linux-x64": {
          "url": "https://github.com/rhysd/actionlint/releases/download/v{version}/actionlint_{version}_linux_amd64.tar.gz",
          "sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8",
          "files": [
            "actionlint"
          ]
        },
        "linux-arm64": {
          "url": "https://github.com/rhysd/actionlint/releases/download/v{version}/actionlint_{version}_linux_arm64.tar.gz",
          "sha256": "325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6",
          "files": [
            "actionlint"
          ]
        },
        "darwin-arm64": {
          "url": "https://github.com/rhysd/actionlint/releases/download/v{version}/actionlint_{version}_darwin_arm64.tar.gz",
          "sha256": "aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f",
          "files": [
            "actionlint"
          ]
        }
      },
      "checksums": {
