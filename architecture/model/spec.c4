specification {
  element actor {
    style {
      shape person
    }
  }

  element system {
    notation "Software system"
  }

  element service {
    notation "Deployable service"
  }

  element webapp {
    notation "Web application"
    style {
      shape browser
    }
  }

  element library {
    notation "Published package"
    style {
      shape component
    }
  }

  // ADR-0044: the repository's own machinery, drawn beside the system a project builds.
  element script {
    notation "Chassis script"
    style {
      shape component
    }
  }

  element records {
    notation "Records"
  }
}
