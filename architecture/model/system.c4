// The system this repository builds. Change it in the same pull request as the structure it describes;
// test/model.test.mjs checks the rules it must satisfy.
model {
  user = actor 'User' {
    description 'Someone who keeps track of their work as tasks.'
  }

  product = system 'ultra-template' {
    description 'Tasks created, listed and moved through todo, in progress and done.'

    // ultra:begin web
    web = webapp 'web' {
      technology 'React, Vite'
      description 'Lists tasks and offers only the status moves the API accepts. Calls /api/tasks on the service behind it.'
      link ../../apps/web/README.md 'README'
    }
    user -> web 'manages tasks in the browser'
    // ultra:end web

    // ultra:begin go-service
    apiGo = service 'api-go' {
      technology 'Go, net/http'
      description 'Task HTTP API in Clean Architecture layers; layer rules enforced by a test.'
      link ../../services/api-go/README.md 'README'
    }
    user -> apiGo 'calls /api/tasks directly or through a client'
    // ultra:end go-service

    // ultra:begin ts-service
    apiTs = service 'api-ts' {
      technology 'TypeScript, Node'
      description 'Task HTTP API with a pure domain core; import boundaries checked on every file.'
      link ../../services/api-ts/README.md 'README'
    }
    user -> apiTs 'calls /api/tasks directly or through a client'
    // ultra:end ts-service

    // ultra:begin py-service
    apiPy = service 'api-py' {
      technology 'Python, WSGI'
      description 'Task HTTP API on the standard library; layer rules enforced by an ast-based check.'
      link ../../services/api-py/README.md 'README'
    }
    user -> apiPy 'calls /api/tasks directly or through a client'
    // ultra:end py-service

    // ultra:begin mcp-server
    mcpServer = service 'mcp-server' {
      technology 'TypeScript, Model Context Protocol SDK'
      description 'Exposes the task API to an AI assistant as MCP tools over stdio or Streamable HTTP. Refuses an illegal status move itself, so the assistant is told which moves are legal instead of discovering a 409.'
      link ../../services/mcp-server/README.md 'README'
    }
    user -> mcpServer 'asks an assistant to manage tasks, which calls its tools'
    // ultra:end mcp-server

    // ultra:begin ts-library
    tsLibrary = library 'ts-library' {
      technology 'TypeScript, npm'
      description 'The task status rules as a typed package on npm, for a client that should offer only the moves the API accepts.'
      link ../../packages/ts-library/README.md 'README'
    }
    user -> tsLibrary 'installs it from npm to offer only the legal status moves'
    // ultra:end ts-library

    // The clients of the task API, each drawn only when both ends are in the project.
    // ultra:begin mcp-server&go-service
    mcpServer -> apiGo 'calls /api/tasks for its tools'
    // ultra:end mcp-server&go-service
    // ultra:begin mcp-server&ts-service
    mcpServer -> apiTs 'calls /api/tasks for its tools'
    // ultra:end mcp-server&ts-service
    // ultra:begin mcp-server&py-service
    mcpServer -> apiPy 'calls /api/tasks for its tools'
    // ultra:end mcp-server&py-service
    // ultra:begin web&go-service
    web -> apiGo 'proxies /api/tasks to it'
    // ultra:end web&go-service
    // ultra:begin web&ts-service
    web -> apiTs 'proxies /api/tasks to it'
    // ultra:end web&ts-service
    // ultra:begin web&py-service
    web -> apiPy 'proxies /api/tasks to it'
    // ultra:end web&py-service
  }

  // ADR-0044: the repository's own machinery, drawn beside the system a project builds. ADR-0046: every
  // script in scripts/ is a link on a chassis element. Only the generator, the knowledge graph and the
  // feature-owned guard scripts carry feature markers; the rest of scripts/ and the ADR seeds ship to every project.
  contributor = actor 'Contributor' {
    description 'Someone working in this repository: runs the gate, reads the records, generates a project.'
  }

  chassis = system 'chassis' {
    description 'The machinery that keeps this repository a versionless template: the gate, the guards, the pinned tools, the environment, the records, the knowledge graph, the generator and the update path — every scripts/*.mjs drawn (ADR-0046).'

    verify = script 'verify' {
      technology 'Node, scripts/verify.mjs, scripts/modules.mjs'
      description 'The single gate CI requires: runs every module check the way CI does and the chassis checks on top.'
      link ../../scripts/verify.mjs 'verify.mjs'
      link ../../scripts/modules.mjs 'modules.mjs'
    }
    contributor -> verify 'runs the gate before pushing'

    guards = script 'guards' {
      technology 'Node, scripts/check-*.mjs'
      description 'Hygiene, docs, safety, plan, pins and architecture checks; the ADR grammar and Enforcement sections included (ADR-0042).'
      link ../../scripts/check-hygiene.mjs 'check-hygiene.mjs'
      link ../../scripts/check-docs.mjs 'check-docs.mjs'
      link ../../scripts/check-safety.mjs 'check-safety.mjs'
      link ../../scripts/check-plan.mjs 'check-plan.mjs'
      link ../../scripts/check-pins.mjs 'check-pins.mjs'
      link ../../scripts/check-architecture.mjs 'check-architecture.mjs'
      // ultra:begin go-service|ts-service|py-service
      link ../../scripts/check-contract.mjs 'check-contract.mjs'
      // ultra:end go-service|ts-service|py-service
      // ultra:begin mcp-server|web|ts-library
      link ../../scripts/check-facts.mjs 'check-facts.mjs'
      // ultra:end mcp-server|web|ts-library
    }
    contributor -> guards 'reads what they enforce'

    adr = records 'decision records' {
      technology 'Markdown, docs/adr/'
      description 'ADRs with a status grammar and a mandatory Enforcement section for structural records (ADR-0042); every architecture rule ships a failing case (ADR-0043).'
      link ../../docs/adr/0000-template.md 'ADR template'
    }
    contributor -> adr 'records and consults decisions'

    tools = script 'pinned tools' {
      technology 'Node, scripts/tools.mjs'
      description 'Installs and runs the hand-pinned tools from scripts/tools/tools.json, every asset checksum-verified before it runs (ADR-0017).'
      link ../../scripts/tools.mjs 'tools.mjs'
    }
    contributor -> tools 'installs the pinned tools with'

    environment = script 'environment' {
      technology 'Node, scripts/setup.mjs, scripts/agent-env.mjs, scripts/doctor.mjs'
      description 'Prepares a fresh checkout: installs every module dependencies, wires the agent environment, and reports what a check could not run.'
      link ../../scripts/setup.mjs 'setup.mjs'
      link ../../scripts/agent-env.mjs 'agent-env.mjs'
      link ../../scripts/doctor.mjs 'doctor.mjs'
    }
    contributor -> environment 'prepares a checkout with'

    dev = script 'dev servers' {
      technology 'Node, scripts/dev.mjs'
      description 'Starts the web app and a task service together for local work.'
      link ../../scripts/dev.mjs 'dev.mjs'
    }
    contributor -> dev 'runs locally with'

    configure = script 'repository configuration' {
      technology 'Node, scripts/configure-github.mjs'
      description 'Applies the settings CI relies on: branch rulesets, the single required check, labels.'
      link ../../scripts/configure-github.mjs 'configure-github.mjs'
    }
    contributor -> configure 'configures the repository with'

    generate = script 'doc generation' {
      technology 'Node, scripts/generate-docs.mjs'
      description 'Rewrites the generated blocks in the docs and READMEs so a restated fact keeps one source (ADR-0013).'
      link ../../scripts/generate-docs.mjs 'generate-docs.mjs'
    }
    contributor -> generate 'regenerates the docs with'

    gate = script 'self-upgrade gate' {
      technology 'Node, scripts/search_replace.mjs'
      description 'Computes the minimal three-way repair the self-upgrade gate may apply; every entry in data/plan.md names its scope (ADR-0037).'
      link ../../scripts/search_replace.mjs 'search_replace.mjs'
    }
    contributor -> gate 'repairs the template through'

    probe = script 'CI probes' {
      technology 'Node, scripts/probe-image.mjs, scripts/coverage-summary.mjs'
      description 'Container image probes and coverage summaries, run where the tools exist: in CI.'
      link ../../scripts/probe-image.mjs 'probe-image.mjs'
      link ../../scripts/coverage-summary.mjs 'coverage-summary.mjs'
    }
    contributor -> probe 'probes images and coverage with'

    update = script 'template updates' {
      technology 'Node, scripts/template-source.mjs, scripts/template-update.mjs'
      description 'Reads the recorded template commit and brings a generated project up to a later one by regenerating and three-way merging (ADR-0041).'
      link ../../scripts/template-source.mjs 'template-source.mjs'
      link ../../scripts/template-update.mjs 'template-update.mjs'
    }
    contributor -> update 'updates a project from the template with'

    // ultra:begin knowledge
    knowledge = records 'knowledge graph' {
      technology 'Node, scripts/knowledge.mjs'
      description 'docs/knowledge/ as the repository memory: ADRs, docs, the extracted graph and written episodes, checked for staleness in CI.'
      link ../../scripts/knowledge.mjs 'knowledge.mjs'
    }
    contributor -> knowledge 'queries the memory before a structural change'
    // ultra:end knowledge

    // ultra:begin template
    template = script 'template' {
      technology 'Node, template/init.mjs'
      description 'Generates a project from a source commit (schema-2 commit-only provenance, ADR-0041): no releases, no tags, no version files.'
      link ../../template/init.mjs 'init.mjs'
    }
    contributor -> template 'generates a project from'
    template -> product 'a commit of this repository'
    // ultra:end template
  }
}
