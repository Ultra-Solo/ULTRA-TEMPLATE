// The system this repository builds. Change it in the same pull request as the structure it describes;
// test/model.test.mjs checks the rules it must satisfy.
model {
  user = actor 'User' {
    description 'Someone who keeps track of their work as tasks.'
  }

  product = system 'ultra-template' {
    description 'Tasks created, listed and moved through todo, in progress and done.'

    // ultra:begin web
    web = webapp 'web' {
      technology 'React, Vite'
      description 'Lists tasks and offers only the status moves the API accepts. Calls /api/tasks on the service behind it.'
      link ../../apps/web/README.md 'README'
    }
    user -> web 'manages tasks in the browser'
    // ultra:end web

    // ultra:begin go-service
    apiGo = service 'api-go' {
      technology 'Go, net/http'
      description 'Task HTTP API in Clean Architecture layers; layer rules enforced by a test.'
      link ../../services/api-go/README.md 'README'
    }
    user -> apiGo 'calls /api/tasks directly or through a client'
    // ultra:end go-service

    // ultra:begin ts-service
    apiTs = service 'api-ts' {
      technology 'TypeScript, Node'
      description 'Task HTTP API with a pure domain core; import boundaries checked on every file.'
      link ../../services/api-ts/README.md 'README'
    }
    user -> apiTs 'calls /api/tasks directly or through a client'
    // ultra:end ts-service

    // ultra:begin py-service
    apiPy = service 'api-py' {
      technology 'Python, WSGI'
      description 'Task HTTP API on the standard library; layer rules enforced by an ast-based check.'
      link ../../services/api-py/README.md 'README'
    }
    user -> apiPy 'calls /api/tasks directly or through a client'
    // ultra:end py-service

    // ultra:begin mcp-server
    mcpServer = service 'mcp-server' {
      technology 'TypeScript, Model Context Protocol SDK'
      description 'Exposes the task API to an AI assistant as MCP tools over stdio or Streamable HTTP. Refuses an illegal status move itself, so the assistant is told which moves are legal instead of discovering a 409.'
      link ../../services/mcp-server/README.md 'README'
    }
    user -> mcpServer 'asks an assistant to manage tasks, which calls its tools'
    // ultra:end mcp-server

    // ultra:begin ts-library
    tsLibrary = library 'ts-library' {
      technology 'TypeScript, npm'
      description 'The task status rules as a typed package on npm, for a client that should offer only the moves the API accepts.'
      link ../../packages/ts-library/README.md 'README'
    }
    user -> tsLibrary 'installs it from npm to offer only the legal status moves'
    // ultra:end ts-library

    // The clients of the task API, each drawn only when both ends are in the project.
    // ultra:begin mcp-server&go-service
    mcpServer -> apiGo 'calls /api/tasks for its tools'
    // ultra:end mcp-server&go-service
    // ultra:begin mcp-server&ts-service
    mcpServer -> apiTs 'calls /api/tasks for its tools'
    // ultra:end mcp-server&ts-service
    // ultra:begin mcp-server&py-service
    mcpServer -> apiPy 'calls /api/tasks for its tools'
    // ultra:end mcp-server&py-service
    // ultra:begin web&go-service
    web -> apiGo 'proxies /api/tasks to it'
    // ultra:end web&go-service
    // ultra:begin web&ts-service
    web -> apiTs 'proxies /api/tasks to it'
    // ultra:end web&ts-service
    // ultra:begin web&py-service
    web -> apiPy 'proxies /api/tasks to it'
    // ultra:end web&py-service
  }

  // ADR-0044: the repository's own machinery, drawn beside the system a project builds. ADR-0046–ADR-0048:
  // every tracked file outside the modules and the ADR records is a link on a chassis element. Only
  // feature-owned files carry feature markers (per template/features.json); everything else — the root
  // files, the .github settings, the skills, the docs, the tests, the core of scripts/ and workflows, the
  // ADR index and seed — ships to every project.
  contributor = actor 'Contributor' {
    description 'Someone working in this repository: runs the gate, reads the records, generates a project.'
  }

  chassis = system 'chassis' {
    description 'The machinery that keeps this repository a versionless template: the gate, the guards, the pinned tools, the environment, the records, the knowledge graph, the generator, the update path, the CI and the repository settings — every tracked file outside the modules drawn as a link (ADR-0046–ADR-0048).'

    root = script 'repository root' {
      technology 'Markdown, JSON, VCS and editor configuration'
      description 'The files every checkout carries: the one set of agent instructions, the readme, the package manifest, the pinned Node version, the ignore and editor rules, the license, security and conduct pages.'
      link ../../AGENTS.md 'AGENTS.md'
      link ../../CLAUDE.md 'CLAUDE.md'
      link ../../GEMINI.md 'GEMINI.md'
      link ../../README.md 'README.md'
      link ../../package.json 'package.json'
      link ../../.node-version '.node-version'
      link ../../.gitignore '.gitignore'
      link ../../.gitattributes '.gitattributes'
      link ../../.editorconfig '.editorconfig'
      link ../../.trivyignore '.trivyignore'
      link ../../LICENSE 'LICENSE'
      link ../../SECURITY.md 'SECURITY.md'
      link ../../CODE_OF_CONDUCT.md 'CODE_OF_CONDUCT.md'
      link ../../CONTRIBUTING.md 'CONTRIBUTING.md'
      // ultra:begin architecture|ts-service|mcp-server|web|ts-library
      link ../../biome.jsonc 'biome.jsonc'
      // ultra:end architecture|ts-service|mcp-server|web|ts-library
      // ultra:begin release
      link ../../release-please-config.json 'release-please-config.json'
      link ../../.release-please-manifest.json '.release-please-manifest.json'
      // ultra:end release
    }
    contributor -> root 'reads the rules and the readme in'

    verify = script 'verify' {
      technology 'Node, scripts/verify.mjs, scripts/modules.mjs'
      description 'The single gate CI requires: runs every module check the way CI does and the chassis checks on top.'
      link ../../scripts/verify.mjs 'verify.mjs'
      link ../../scripts/modules.mjs 'modules.mjs'
      link ../../.github/workflows/verify.yml 'verify.yml'
    }
    contributor -> verify 'runs the gate before pushing'

    tests = script 'chassis tests' {
      technology 'Node, test/'
      description 'The tests of the gate, the guards and the chassis itself; the module checks run the modules’ own tests the same way.'
      link ../../test/agent-env.test.mjs 'agent-env.test.mjs'
      link ../../test/agents-claims.test.mjs 'agents-claims.test.mjs'
      // ultra:begin architecture
      link ../../test/check-architecture.test.mjs 'check-architecture.test.mjs'
      // ultra:end architecture
      // ultra:begin go-service|ts-service|py-service
      link ../../test/check-contract.test.mjs 'check-contract.test.mjs'
      link ../../test/dev.test.mjs 'dev.test.mjs'
      // ultra:end go-service|ts-service|py-service
      link ../../test/check-docs.test.mjs 'check-docs.test.mjs'
      // ultra:begin mcp-server|web|ts-library
      link ../../test/check-facts.test.mjs 'check-facts.test.mjs'
      // ultra:end mcp-server|web|ts-library
      link ../../test/check-hygiene.test.mjs 'check-hygiene.test.mjs'
      link ../../test/check-pins.test.mjs 'check-pins.test.mjs'
      link ../../test/check-plan.test.mjs 'check-plan.test.mjs'
      link ../../test/check-safety.test.mjs 'check-safety.test.mjs'
      link ../../test/claims.mjs 'claims.mjs'
      link ../../test/configure-github.test.mjs 'configure-github.test.mjs'
      link ../../test/coverage-summary.test.mjs 'coverage-summary.test.mjs'
      link ../../test/doctor.test.mjs 'doctor.test.mjs'
      link ../../test/generate-docs.test.mjs 'generate-docs.test.mjs'
      // ultra:begin knowledge
      link ../../test/knowledge.test.mjs 'knowledge.test.mjs'
      // ultra:end knowledge
      link ../../test/modules.test.mjs 'modules.test.mjs'
      link ../../test/probe-image.test.mjs 'probe-image.test.mjs'
      link ../../test/search_replace.test.mjs 'search_replace.test.mjs'
      link ../../test/setup.test.mjs 'setup.test.mjs'
      link ../../test/tools.test.mjs 'tools.test.mjs'
    }
    verify -> tests 'runs the chassis tests from'

    guards = script 'guards' {
      technology 'Node, scripts/check-*.mjs'
      description 'Hygiene, docs, safety, plan, pins and architecture checks; the ADR grammar and Enforcement sections included (ADR-0042).'
      link ../../scripts/check-hygiene.mjs 'check-hygiene.mjs'
      link ../../scripts/check-docs.mjs 'check-docs.mjs'
      link ../../scripts/check-safety.mjs 'check-safety.mjs'
      link ../../scripts/check-plan.mjs 'check-plan.mjs'
      link ../../scripts/check-pins.mjs 'check-pins.mjs'
      link ../../scripts/check-architecture.mjs 'check-architecture.mjs'
      // ultra:begin go-service|ts-service|py-service
      link ../../scripts/check-contract.mjs 'check-contract.mjs'
      // ultra:end go-service|ts-service|py-service
      // ultra:begin mcp-server|web|ts-library
      link ../../scripts/check-facts.mjs 'check-facts.mjs'
      // ultra:end mcp-server|web|ts-library
      // ultra:begin go-service|ts-service|py-service|mcp-server|web|ts-library
      link ../../scripts/contract/tasks-api.json 'tasks-api.json'
      link ../../scripts/contract/openapi.json 'openapi.json'
      link ../../scripts/rules/load.mjs 'load.mjs'
      link ../../scripts/rules/task-rules.json 'task-rules.json'
      // ultra:end go-service|ts-service|py-service|mcp-server|web|ts-library
    }
    contributor -> guards 'reads what they enforce'

    adr = records 'decision records' {
      technology 'Markdown, docs/adr/'
      description 'ADRs with a status grammar and a mandatory Enforcement section for structural records (ADR-0042); every architecture rule ships a failing case (ADR-0043).'
      link ../../docs/adr/README.md 'index'
      link ../../docs/adr/0000-template.md 'ADR template'
    }
    contributor -> adr 'records and consults decisions'

    skills = script 'agent skills' {
      technology 'Markdown, .claude/'
      description 'The step-by-step skills agents follow and the settings that wire them; each feature-owned skill ships with its feature (ADR-0009).'
      link ../../.claude/settings.json 'settings.json'
      // ultra:begin go-service
      link ../../.claude/skills/add-endpoint-go/SKILL.md 'add-endpoint-go'
      // ultra:end go-service
      // ultra:begin py-service
      link ../../.claude/skills/add-endpoint-py/SKILL.md 'add-endpoint-py'
      // ultra:end py-service
      // ultra:begin ts-service
      link ../../.claude/skills/add-endpoint-ts/SKILL.md 'add-endpoint-ts'
      // ultra:end ts-service
      // ultra:begin mcp-server
      link ../../.claude/skills/add-mcp-tool/SKILL.md 'add-mcp-tool'
      // ultra:end mcp-server
      // ultra:begin go-service|ts-service|py-service|mcp-server|web|ts-library
      link ../../.claude/skills/change-task-contract/SKILL.md 'change-task-contract'
      // ultra:end go-service|ts-service|py-service|mcp-server|web|ts-library
      // ultra:begin knowledge
      link ../../.claude/skills/consult-knowledge/SKILL.md 'consult-knowledge'
      link ../../.claude/skills/record-episode/SKILL.md 'record-episode'
      link ../../.claude/skills/triage-and-fix/SKILL.md 'triage-and-fix'
      // ultra:end knowledge
      link ../../.claude/skills/record-decision/SKILL.md 'record-decision'
      link ../../.claude/skills/update-from-template/SKILL.md 'update-from-template'
    }
    contributor -> skills 'follows the skills of'

    docs = records 'documentation' {
      technology 'Markdown, docs/'
      description 'The guides indexed by docs/README.md; the ADR log is drawn on the adr element, the knowledge memory on knowledge.'
      link ../../docs/README.md 'README'
      link ../../docs/growing-the-ci.md 'growing-the-ci.md'
      link ../../docs/toolchain-updates.md 'toolchain-updates.md'
      // ultra:begin devcontainer
      link ../../docs/devcontainer-scan-baseline.md 'devcontainer-scan-baseline.md'
      // ultra:end devcontainer
    }
    contributor -> docs 'reads the documentation in'

    tools = script 'pinned tools' {
      technology 'Node, scripts/tools.mjs'
      description 'Installs and runs the hand-pinned tools from scripts/tools/tools.json, every asset checksum-verified before it runs (ADR-0017).'
      link ../../scripts/tools.mjs 'tools.mjs'
      link ../../scripts/tools/tools.json 'tools.json'
    }
    contributor -> tools 'installs the pinned tools with'

    environment = script 'environment' {
      technology 'Node, scripts/setup.mjs, scripts/agent-env.mjs, scripts/doctor.mjs'
      description 'Prepares a fresh checkout: installs every module dependencies, wires the agent environment, and reports what a check could not run.'
      link ../../scripts/setup.mjs 'setup.mjs'
      link ../../scripts/agent-env.mjs 'agent-env.mjs'
      link ../../scripts/doctor.mjs 'doctor.mjs'
      // ultra:begin devcontainer
      link ../../.devcontainer/devcontainer.json 'devcontainer.json'
      link ../../.devcontainer/Dockerfile 'Dockerfile'
      // ultra:end devcontainer
    }
    contributor -> environment 'prepares a checkout with'

    dev = script 'dev servers' {
      technology 'Node, scripts/dev.mjs'
      description 'Starts the web app and a task service together for local work.'
      link ../../scripts/dev.mjs 'dev.mjs'
    }
    contributor -> dev 'runs locally with'

    configure = script 'repository configuration' {
      technology 'Node, scripts/configure-github.mjs'
      description 'Applies the settings CI relies on: branch rulesets, the single required check, labels.'
      link ../../scripts/configure-github.mjs 'configure-github.mjs'
    }
    contributor -> configure 'configures the repository with'

    generate = script 'doc generation' {
      technology 'Node, scripts/generate-docs.mjs'
      description 'Rewrites the generated blocks in the docs and READMEs so a restated fact keeps one source (ADR-0013).'
      link ../../scripts/generate-docs.mjs 'generate-docs.mjs'
    }
    contributor -> generate 'regenerates the docs with'

    gate = script 'self-upgrade gate' {
      technology 'Node, scripts/search_replace.mjs'
      description 'Computes the minimal three-way repair the self-upgrade gate may apply; every entry in data/plan.md names its scope (ADR-0037).'
      link ../../scripts/check-plan.mjs 'check-plan.mjs'
      link ../../scripts/search_replace.mjs 'search_replace.mjs'
      link ../../data/plan.md 'plan.md'
    }
    contributor -> gate 'repairs the template through'

    hooks = script 'git hooks' {
      technology 'Shell, scripts/hooks/'
      description 'Optional hooks a checkout may install into .git/hooks: the safety guard on every commit, the knowledge sync before it.'
      link ../../scripts/hooks/check-safety 'check-safety'
      // ultra:begin knowledge
      link ../../scripts/hooks/knowledge 'knowledge'
      // ultra:end knowledge
    }
    contributor -> hooks 'installs as git hooks'

    ci = script 'CI workflows' {
      technology 'GitHub Actions, .github/workflows/'
      description 'The workflows that gate every push and pull request: the single required verify job, the security and supply-chain scans, the pinned-tool and PR-title checks, and the cloud agents setup.'
      link ../../.github/workflows/codeql.yml 'codeql.yml'
      link ../../.github/workflows/copilot-setup-steps.yml 'copilot-setup-steps.yml'
      link ../../.github/workflows/pins.yml 'pins.yml'
      link ../../.github/workflows/pr-title.yml 'pr-title.yml'
      link ../../.github/workflows/scorecard.yml 'scorecard.yml'
      link ../../.github/workflows/security.yml 'security.yml'
      // ultra:begin architecture
      link ../../.github/workflows/architecture.yml 'architecture.yml'
      // ultra:end architecture
      // ultra:begin devcontainer
      link ../../.github/workflows/devcontainer-scan.yml 'devcontainer-scan.yml'
      // ultra:end devcontainer
      // ultra:begin mcp-server
      link ../../.github/workflows/mcp-publish.yml 'mcp-publish.yml'
      // ultra:end mcp-server
      // ultra:begin release
      link ../../.github/workflows/release.yml 'release.yml'
      // ultra:end release
      link ../../.github/actions/module/action.yml 'module action'
      link ../../.github/actions/tool/action.yml 'tool action'
    }
    ci -> verify 'runs the gate before merge'

    github = script 'repository settings' {
      technology 'YAML, Markdown, .github/'
      description 'The settings that shape CI and contribution outside the workflows: the actionlint and zizmor audits, Dependabot, CODEOWNERS, the issue and pull request templates, the Copilot instructions and the prompt files.'
      link ../../.github/actionlint.yaml 'actionlint.yaml'
      link ../../.github/zizmor.yml 'zizmor.yml'
      link ../../.github/dependabot.yml 'dependabot.yml'
      link ../../.github/CODEOWNERS 'CODEOWNERS'
      link ../../.github/copilot-instructions.md 'copilot-instructions.md'
      link ../../.github/pull_request_template.md 'pull_request_template.md'
      link ../../.github/ISSUE_TEMPLATE/bug_report.yml 'bug_report.yml'
      link ../../.github/ISSUE_TEMPLATE/config.yml 'config.yml'
      link ../../.github/ISSUE_TEMPLATE/feature_request.yml 'feature_request.yml'
      link ../../.github/prompts/verify-and-report.prompt.md 'verify-and-report.prompt.md'
      // ultra:begin knowledge
      link ../../.github/prompts/triage-and-fix.prompt.md 'triage-and-fix.prompt.md'
      // ultra:end knowledge
      // ultra:begin template
      link ../../.github/agents/synthesis-architect-pro.agent.md 'synthesis-architect-pro.agent.md'
      // ultra:end template
    }
    github -> ci 'configures the audits of'

    probe = script 'CI probes' {
      technology 'Node, scripts/probe-image.mjs, scripts/coverage-summary.mjs'
      description 'Container image probes and coverage summaries, run where the tools exist: in CI.'
      link ../../scripts/probe-image.mjs 'probe-image.mjs'
      link ../../scripts/coverage-summary.mjs 'coverage-summary.mjs'
    }
    contributor -> probe 'probes images and coverage with'

    update = script 'template updates' {
      technology 'Node, scripts/template-source.mjs, scripts/template-update.mjs'
      description 'Reads the recorded template commit and brings a generated project up to a later one by regenerating and three-way merging (ADR-0041).'
      link ../../scripts/template-source.mjs 'template-source.mjs'
      link ../../scripts/template-update.mjs 'template-update.mjs'
    }
    contributor -> update 'updates a project from the template with'

    // ultra:begin knowledge
    knowledge = records 'knowledge graph' {
      technology 'Node, scripts/knowledge.mjs'
      description 'docs/knowledge/ as the repository memory: ADRs, docs, the extracted graph and written episodes, checked for staleness in CI.'
      link ../../scripts/knowledge.mjs 'knowledge.mjs'
      link ../../scripts/knowledge/core.mjs 'core.mjs'
      link ../../scripts/knowledge/graphify.mjs 'graphify.mjs'
      link ../../scripts/knowledge/query.mjs 'query.mjs'
      link ../../docs/knowledge/README.md 'docs/knowledge/README.md'
      link ../../docs/knowledge/graph.json 'graph.json'
      link ../../docs/knowledge/episodes/README.md 'docs/knowledge/episodes/README.md'
    }
    contributor -> knowledge 'queries the memory before a structural change'
    // ultra:end knowledge

    // ultra:begin template
    template = script 'template' {
      technology 'Node, template/init.mjs'
      description 'Generates a project from a source commit (schema-2 commit-only provenance, ADR-0041): no releases, no tags, no version files.'
      link ../../template/init.mjs 'init.mjs'
      link ../../template/clean.mjs 'clean.mjs'
      link ../../template/features.json 'features.json'
      link ../../template/test-source.mjs 'test-source.mjs'
      link ../../template/README.md 'README.md'
      link ../../template/claims.test.mjs 'claims.test.mjs'
      link ../../template/clean.test.mjs 'clean.test.mjs'
      link ../../template/init.test.mjs 'init.test.mjs'
      link ../../template/no-version.test.mjs 'no-version.test.mjs'
      link ../../template/provenance.test.mjs 'provenance.test.mjs'
      link ../../template/template-update.test.mjs 'template-update.test.mjs'
      link ../../.github/workflows/template-test.yml 'template-test.yml'
    }
    contributor -> template 'generates a project from'
    template -> product 'a commit of this repository'
    // ultra:end template
  }
}
