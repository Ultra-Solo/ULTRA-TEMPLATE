{
  "name": "architecture",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "likec4 start model",
    "validate": "likec4 validate model",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "likec4 build model --output dist",
    "coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.mjs\"",
    "lint": "biome ci .",
    "verify": "npm run lint && npm run validate && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "likec4": "^1.59.4"
  }
}
